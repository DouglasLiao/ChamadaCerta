# Copie para .env. Este modelo contem somente configuracoes publicas de desenvolvimento.
# VITE_* e incorporado ao APK; nunca use para senhas, tokens ou chaves privadas.
VITE_CONTACT_PAGE_SIZE=50
VITE_CONTACT_RECORD_PAGE_SIZE=20
VITE_BRIDGE_DATA_TIMEOUT_MS=15000
VITE_BRIDGE_PERMISSION_TIMEOUT_MS=180000

# Ferramentas Node/Vite: nao sao incorporadas ao aplicativo.
DEV_HOST=127.0.0.1
DEV_PORT=3100
CHROME_DEBUG_PORT=9337
NATIVE_PREVIEW=0
CONTACTS_BENCHMARK=0
# APP_URL=http://127.0.0.1:3100/
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# JAVA_HOME=C:/Ferramentas/jdk-17
# ANDROID_HOME=C:/Ferramentas/android-sdk
